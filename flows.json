    {
        "id": "89e191a95ba19601",
        "type": "function",
        "z": "a5f0c1d2e3b40001",
        "name": "online detector",
        "func": "// TODO (Node-RED): fire an alert when the device goes offline.\n// msg.payload is \"online\" or \"offline\" (topic iot/<TEAM_ID>/status).\n// 1. Remember the previous value with context.get('state') / context.set('state', ...).\n// 2. If the value CHANGED to \"offline\", return { payload: \"ALERT: device offline at <time>\" }.\n//    The notification node shows msg.payload on the dashboard.\n// 3. Otherwise return null (nothing is sent).\n// Optional: also return a message when it changes back to \"online\".\nif(context.get('state') == \"offline\" && msg.payload == \"online\") {\n    context.set('state', msg.payload);\n    return { payload: \"ALERT: device online at \" + msg.timestamp.toLocaleTimeString('en-US', { timeZone: 'America/Los_Angeles' })};\n}\ncontext.set('state', msg.payload);\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
