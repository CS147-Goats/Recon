    {
        "id": "a5f0c1d2e3b4010c",
        "type": "function",
        "z": "a5f0c1d2e3b40001",
        "name": "Notify on offline transition",
        "func": "const status = msg.payload && msg.payload.status;\nif (status !== 'online' && status !== 'offline') return null;\nconst previous = context.get('state');\ncontext.set('state', status);\nif (previous === 'online' && status === 'offline') {\n    return { payload: 'ALERT: device went offline at ' + msg.timestamp.toLocaleTimeString() };\n}\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 360,
        "wires": [
