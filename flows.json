    {
        "id": "a5f0c1d2e3b4010c",
        "type": "function",
        "z": "a5f0c1d2e3b40001",
        "name": "offline detector (TODO)",
        "func": "// TODO (Node-RED): fire an alert when the device goes offline.\n// msg.payload is \"online\" or \"offline\" (topic iot/<TEAM_ID>/status).\n// 1. Remember the previous value with context.get('state') / context.set('state', ...).\n// 2. If the value CHANGED to \"offline\", return { payload: \"ALERT: device offline at <time>\" }.\n//    The notification node shows msg.payload on the dashboard.\n// 3. Otherwise return null (nothing is sent).\n// Optional: also return a message when it changes back to \"online\".\nif(context.get('state') == \"online\" && msg.payload == \"offline\") {\n    context.set('state', msg.payload);\n    return { payload: \"ALERT: device offline at \" + msg.timestamp.toLocaleTimeString('en-US', { timeZone: 'America/Los_Angeles' })};\n}\ncontext.set('state', msg.payload);\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 360,
        "wires": [
            [
                "a5f0c1d2e3b4010d",
                "a5f0c1d2e3b4010e"
            ]
        ]
